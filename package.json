{
  "name": "nanochart.js",
  "version": "0.1.0",
  "description": "Tiny zero-dependency canvas charting library with a plugin core and Telegram-style themes",
  "type": "module",
  "license": "MIT",
  "author": "Oleg Oskolsky (https://github.com/highfeed)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highfeed/nanochart.git"
  },
  "homepage": "https://github.com/highfeed/nanochart#readme",
  "bugs": {
    "url": "https://github.com/highfeed/nanochart/issues"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/nanochart.global.js",
  "jsdelivr": "./dist/nanochart.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/chart.d.ts",
      "default": "./dist/core/chart.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chart",
    "charts",
    "canvas",
    "graph",
    "telegram",
    "dataviz",
    "lightweight"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "serve": "python3 -m http.server 4173",
    "start": "npm run build && npm run serve",
    "prepublishOnly": "npm run build && npm test",
    "site": "npm run build && node scripts/site.mjs",
    "check:examples": "npm run build && node scripts/check-examples.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.1",
    "happy-dom": "^19.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.63.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
